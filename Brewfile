# This is an input file for the Homebrew package manager on Mac and Linux.
# Use the following command to install all development dependencies:
#
# brew bundle install

# GitHub command-line tool
brew "gh"
# Distributed revision control system
brew "git"
# Open source programming language to build simple/reliable/efficient software
brew "go-task"
# Fast, flexible, config-based cli for linting Markdown/CommonMark files
brew "markdownlint-cli2"
# npm for frontend development
brew "node"
# Object-relational database system
brew "postgresql@17"
# Command-line tool for interacting with GRPC services
brew "grpcurl"

# Casks
#
# Casks won't work on Linux, as Linuxbrew doesn't support Casks.
# They will be ignored with a warning.

# Command-line shell and scripting language
cask "powershell"

# We need dotnet-sdk, dotnet is not sufficient.
# Note that Homebrew only supports the latest version (9 as of June 2025)
# We should still able to target the LTS version (8)
cask "dotnet-sdk"
# Visual Studio Code
cask "visual-studio-code"
